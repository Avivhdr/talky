# Copy to ~/.config/talky/.env (scripts/install.sh links this repo's .env there if it exists).
# Every key is optional. Without any of them Talky runs fully offline with whisper.cpp
# and pastes the raw transcript.

# LLM cleanup / pipes
ANTHROPIC_API_KEY=

# Cloud transcription (used when transcription.backend is "auto", "groq" or "openai")
GROQ_API_KEY=
OPENAI_API_KEY=
